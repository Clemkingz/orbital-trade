// Orbit Trade — core data model.
// Design reference for the future backend (not used yet — the apps run on browser mock data).
//
// Rule: balances are NEVER stored. A balance is SUM(ledger_entries.amount_btc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING_APPROVAL // admin sign-ups wait for a super admin
  REJECTED
  SUSPENDED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUESTED
}

enum IdType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENCE
  VOTERS_CARD
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  TRADE_PNL
  FEE
  ADJUSTMENT
}

enum AdjustmentReason {
  DEPOSIT_CREDIT
  CORRECTION
  BONUS
  REFUND
}

enum DepositClaimStatus {
  PENDING
  MATCHED
  REJECTED
  NEEDS_INFO
}

enum TradeSide {
  BUY
  SELL
}

enum CopyStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum WithdrawalStatus {
  AWAITING_APPROVAL
  PROCESSING
  COMPLETED
  REJECTED
}

model User {
  id               String        @id @default(cuid())
  firstName        String        @map("first_name")
  lastName         String        @map("last_name")
  email            String        @unique
  emailVerifiedAt  DateTime?     @map("email_verified_at")
  phone            String?
  country          String?
  currency         String        @default("USD") // display currency, from country
  passwordHash     String        @map("password_hash")
  totpSecret       String?       @map("totp_secret")
  totpEnabled      Boolean       @default(false) @map("totp_enabled")
  role             Role          @default(USER)
  status           AccountStatus @default(ACTIVE)
  kycStatus        KycStatus     @default(NOT_SUBMITTED) @map("kyc_status")
  kycReason        String?       @map("kyc_reason")
  referralCode     String?       @map("referral_code")
  lastBuyRedirectAt DateTime?    @map("last_buy_redirect_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  sessions            Session[]
  verificationCodes   VerificationCode[]
  kycSubmissions      KycSubmission[]      @relation("KycSubmitter")
  depositClaims       DepositClaim[]
  ledgerEntries       LedgerEntry[]
  copySubscriptions   CopySubscription[]
  withdrawals         Withdrawal[]
  withdrawalAddresses WithdrawalAddress[]
  notifications       Notification[]

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // "user" | "admin"
  ip         String?
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

/// Email verification codes and password-reset tokens (hashed).
model VerificationCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // "email" | "reset" | "withdrawal"
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("verification_codes")
}

model KycSubmission {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation("KycSubmitter", fields: [userId], references: [id])
  idType       IdType    @map("id_type")
  files        Json // { front, back?, selfie } — private storage keys, never public URLs
  vendorResult Json?     @map("vendor_result")
  status       KycStatus @default(PENDING_REVIEW)
  reviewerId   String?   @map("reviewer_id")
  reason       String?
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("kyc_submissions")
}

/// One active row at a time (active_to IS NULL). Old rows monitored 90 days (FR-5.6).
model PlatformWallet {
  id         String    @id @default(cuid())
  address    String
  network    String    @default("bitcoin")
  activeFrom DateTime  @default(now()) @map("active_from")
  activeTo   DateTime? @map("active_to")
  setBy      String    @map("set_by")
  reason     String

  @@map("platform_wallet")
}

model DepositClaim {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  user        User               @relation(fields: [userId], references: [id])
  txHash      String             @unique @map("tx_hash") // FR-5.5: credited once only
  amountBtc   Decimal            @map("amount_btc")
  fromAddress String             @map("from_address")
  status      DepositClaimStatus @default(PENDING)
  note        String?
  reviewerId  String?            @map("reviewer_id")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@map("deposit_claims")
}

/// Append-only. No UPDATE or DELETE from application code.
model LedgerEntry {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  user             User              @relation(fields: [userId], references: [id])
  type             LedgerEntryType
  amountBtc        Decimal           @map("amount_btc") // signed
  fiatAmount       Decimal?          @map("fiat_amount") // value in the user's currency when posted
  fiatCurrency     String?           @map("fiat_currency")
  btcPrice         Decimal?          @map("btc_price") // BTC price in fiat_currency used for conversion
  reference        String? // tx hash, trade id, withdrawal id, "trader:<id>"
  adjustmentReason AdjustmentReason? @map("adjustment_reason")
  note             String?
  createdBy        String            @map("created_by")
  approvedBy       String?           @map("approved_by")
  createdAt        DateTime          @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("ledger_entries")
}

/// Adjustments above the threshold wait here for a super admin (FR-8.6).
model PendingAdjustment {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  amountBtc    Decimal          @map("amount_btc")
  fiatAmount   Decimal?         @map("fiat_amount")
  fiatCurrency String?          @map("fiat_currency")
  btcPrice     Decimal?         @map("btc_price")
  reason       AdjustmentReason
  note         String
  requestedBy  String           @map("requested_by")
  status       String           @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedBy    String?          @map("decided_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  decidedAt    DateTime?        @map("decided_at")

  @@map("pending_adjustments")
}

model Withdrawal {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id])
  amountBtc  Decimal          @map("amount_btc")
  feeBtc     Decimal          @map("fee_btc")
  address    String
  status     WithdrawalStatus
  decidedBy  String?          @map("decided_by")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@map("withdrawals")
}

model WithdrawalAddress {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  address   String
  label     String
  createdAt DateTime @default(now()) @map("created_at") // usable after 24 h

  @@unique([userId, address])
  @@map("withdrawal_addresses")
}

model BuyPlatform {
  id             String  @id @default(cuid())
  name           String
  logoText       String  @map("logo_text")
  color          String
  linkUrl        String  @map("link_url")
  paymentMethods Json    @map("payment_methods") // string[]
  sortOrder      Int     @default(0) @map("sort_order")
  active         Boolean @default(true)

  @@map("buy_platforms")
}

/// Wins / losses / returns are computed from `trades`, never stored.
model Trader {
  id                  String             @id @default(cuid())
  name                String
  photoUrl            String?            @map("photo_url")
  hue                 Int                @default(262)
  yearsExperience     Int                @map("years_experience")
  typicalTradeSizeBtc Decimal            @map("typical_trade_size_btc")
  bio                 String
  strategy            String
  riskLevel           Int                @map("risk_level") // 1–5
  minAllocation       Decimal            @map("min_allocation")
  feePct              Decimal            @map("fee_pct")
  tradingAccountId    String?            @map("trading_account_id")
  active              Boolean            @default(true)
  demo                Boolean            @default(false)
  createdAt           DateTime           @default(now()) @map("created_at")
  trades              Trade[]
  subscriptions       CopySubscription[]

  @@map("traders")
}

model Trade {
  id       String    @id @default(cuid())
  traderId String    @map("trader_id")
  trader   Trader    @relation(fields: [traderId], references: [id])
  side     TradeSide
  entry    Decimal
  exit     Decimal?
  size     Decimal
  openedAt DateTime  @map("opened_at")
  closedAt DateTime? @map("closed_at")
  mirroredAt DateTime? @map("mirrored_at") // when copier P&L was posted

  @@map("trades")
}

/// Prop account only — never client funds (FR-1.4).
model BotTrade {
  id       String    @id @default(cuid())
  side     TradeSide
  entry    Decimal
  exit     Decimal?
  size     Decimal
  pnl      Decimal?
  openedAt DateTime  @map("opened_at")
  closedAt DateTime? @map("closed_at")

  @@map("bot_trades")
}

model CopySubscription {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  user          User       @relation(fields: [userId], references: [id])
  traderId      String     @map("trader_id")
  trader        Trader     @relation(fields: [traderId], references: [id])
  allocationBtc Decimal    @map("allocation_btc")
  stopLossPct   Decimal?   @map("stop_loss_pct")
  status        CopyStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("copy_subscriptions")
}

model DashboardConfig {
  id            String   @id @default(cuid())
  tiles         Json // [{ id, visible, order, label }]
  announcements Json // [{ id, title, body, segment, kind, tone, createdAt }]
  version       Int
  publishedBy   String   @map("published_by")
  publishedAt   DateTime @default(now()) @map("published_at")

  @@map("dashboard_config")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Read-only. No delete path exists, even for super admins (FR-8.7).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String   @map("actor_id")
  actorName String   @map("actor_name")
  action    String
  target    String
  before    Json?
  after     Json?
  ip        String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_log")
}
