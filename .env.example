# ── Database / cache ──────────────────────────────────────
DATABASE_URL=postgresql://orbit:orbit@localhost:5432/orbit_trade
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────
API_PORT=4000
JWT_SECRET=change-me
WEB_ORIGIN=http://localhost:3000
# "mock" (default): browser mock data. "live": call the real API at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:4000
# Admin console dev server (proxied at localhost:3000/admin)
ADMIN_DEV_URL=http://localhost:3001
# BTC price (USD) used for conversions in the mock data layer
NEXT_PUBLIC_BTC_USD_PRICE=96420

# ── Ledger rules (FR-8.6, FR-5.7) ─────────────────────────
ADJUSTMENT_SECOND_APPROVAL_BTC=0.05
WITHDRAWAL_ADMIN_APPROVAL_BTC=0.1
DEPOSIT_REQUIRED_CONFIRMATIONS=2

# ── Integrations (fill in once contracts are signed) ──────
CUSTODIAN_API_KEY=
BLOCKCHAIN_MONITOR_WEBHOOK_SECRET=
MARKET_DATA_WS_URL=
NEWS_API_KEY=
KYC_VENDOR_API_KEY=
MAXMIND_LICENSE_KEY=
RESEND_API_KEY=
TERMII_API_KEY=
S3_ENDPOINT=
S3_BUCKET_KYC=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Front-end switches (apps/web/lib/config.ts) ───────────
NEXT_PUBLIC_BRAND_NAME=Orbit Trade
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Prop bot label (FR-1.4): "firm" shows "Prop account · firm capital", anything else shows "Simulated"
NEXT_PUBLIC_PROP_ACCOUNT_MODE=simulated
# Set to false once the market-data licence gives real-time index quotes (FR-1.6)
NEXT_PUBLIC_INDEX_DELAYED=true
NEXT_PUBLIC_ADJUSTMENT_APPROVAL_BTC=0.05
NEXT_PUBLIC_WITHDRAWAL_APPROVAL_BTC=0.1
# Send visitor heartbeats to the API (off until the backend exists)
NEXT_PUBLIC_ENABLE_PRESENCE=true
